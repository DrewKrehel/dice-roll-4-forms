<h1>Dice Roll</h1>

<form action="/process_roll">
  <label for="number_id">Number of dice to roll?</label>
  <input id="number_id" type="text" name="dice">
  <label for="sides_id">How many sides per die?</label>
  <input id="sides_id" type="text" name="sides">
  <button type="submit">Roll!</button>
</form>
